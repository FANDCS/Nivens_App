<?xml version="1.0" encoding="utf-8"?>
<!--
  Στατικό app shortcut — εμφανίζεται όταν ο χρήστης κάνει long-press
  (μεγάλο κλικ) στο εικονίδιο της εφαρμογής. Ανοίγει απευθείας μια νέα,
  κενή σημείωση μέσω του ACTION_QUICK_NOTE (βλ. MainActivity.kt).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_note"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/quick_note_short_label"
        android:shortcutLongLabel="@string/quick_note_long_label">
        <intent
            android:action="com.example.notes_app.ACTION_QUICK_NOTE"
            android:targetPackage="com.example.notes_app"
            android:targetClass="com.example.notes_app.MainActivity" />
    </shortcut>
</shortcuts>
